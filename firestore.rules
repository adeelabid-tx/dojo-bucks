rules_version = '2';
// Dojo Bucks security rules. GitHub publishes this to Firebase automatically when it changes on main.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // The dojo owner signs in with this email and is always Center Director.
    function isOwner() { return signedIn() && request.auth.token.email == 'adeelabid.tx@gmail.com'; }
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isDirector() { return isOwner() || (isStaff() && staffDoc().role == 'director'); }
    function isSensei() { return isDirector() || (isStaff() && staffDoc().role == 'sensei'); }
    function canView() { return isSensei() || (isStaff() && staffDoc().role == 'viewer'); }
    // Parents (shared parent code) only see the leaderboard and Dojo News.
    function canSee() { return canView() || (isStaff() && staffDoc().role == 'parent') || isFamily(); }
    // A family signs in with its own code and can only request rewards for its own ninja.
    function isFamily() { return signedIn() && exists(/databases/$(database)/documents/families/$(request.auth.uid)); }
    function famNinja() { return get(/databases/$(database)/documents/families/$(request.auth.uid)).data.ninjaId; }
    // Rewards parents can request: the categories marked for it in the Reward Shop, or Legendary until the shop is first saved.
    function parentItems() {
      let shop = /databases/$(database)/documents/settings/shop;
      return exists(shop) && ('parentIds' in get(shop).data) ? get(shop).data.parentIds : ['gaming', 'daycamp', 'bday', 'fee', 'summer'];
    }
    function num(m, k) { return m.get(k, 0); }
    // Bucks must be saved as numbers (text like "73" would be glued to new bucks instead of added).
    function typed(k) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny([k]) || request.resource.data[k] is number; }
    function moneyTyped() { return typed('balance') && typed('earned') && typed('spent') && typed('lost'); }
    function newTyped(k) { return !(k in request.resource.data) || request.resource.data[k] is number; }
    function oldTyped() { return resource.data.get('balance', 0) is number && resource.data.get('earned', 0) is number && resource.data.get('spent', 0) is number && resource.data.get('lost', 0) is number; }
    function allNumbers() { return request.resource.data.get('balance', 0) is number && request.resource.data.get('earned', 0) is number && request.resource.data.get('spent', 0) is number && request.resource.data.get('lost', 0) is number; }
    function moneyTypedNew() { return newTyped('balance') && newTyped('earned') && newTyped('spent') && newTyped('lost'); }
    // Rewards a sensei can give without director approval: the categories marked for it in the Reward Shop
    // (settings/shop.quickIds), or the built-in Quick Perks until the director first saves the shop.
    function quickPerks() {
      let shop = /databases/$(database)/documents/settings/shop;
      return exists(shop) ? get(shop).data.quickIds : ['break5', 'seat5', 'seat10', 'seat15', 'seatall'];
    }

    // Names and roles shown on the sign-in screen (no kids' data here).
    match /public/{doc} {
      allow read: if true;
      allow write: if isDirector();
    }
    match /staff/{uid} {
      allow read: if canView() || (signedIn() && request.auth.uid == uid);
      allow write: if isDirector();
    }
    match /settings/{doc} {
      allow read: if canSee();
      allow write: if isDirector();
    }
    match /ninjas/{id} {
      allow read: if canSee();
      allow create: if isDirector() && moneyTypedNew();
      allow delete: if isDirector();
      // Senseis may change bucks earned or lost (and the avatar), or spend bucks on Quick Perks.
      // Belts, levels, names and bigger rewards need a director.
      allow update: if moneyTyped() && (isDirector() || (isSensei()
        && num(request.resource.data, 'balance') >= 0
        // Senseis change a ninja by at most 10,000 bucks at once; more needs the Center Director.
        && (!oldTyped() || (num(request.resource.data, 'balance') - num(resource.data, 'balance') <= 10000
                            && num(resource.data, 'balance') - num(request.resource.data, 'balance') <= 10000))
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'earned', 'lost', 'head'])
            && num(request.resource.data, 'balance') - num(resource.data, 'balance')
               == (num(request.resource.data, 'earned') - num(resource.data, 'earned')) - (num(request.resource.data, 'lost') - num(resource.data, 'lost')))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'spent'])
            && num(request.resource.data, 'balance') - num(resource.data, 'balance')
               == num(resource.data, 'spent') - num(request.resource.data, 'spent')))
        // A ninja whose bucks were once saved as text gets turned back into numbers by the next change.
        || (isSensei() && !oldTyped() && allNumbers()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'earned', 'lost', 'spent', 'head'])
            && request.resource.data.balance >= 0)));
    }
    match /log/{id} {
      allow read: if canSee();
      allow create: if isDirector() || (isSensei()
        && request.resource.data.by == request.auth.uid
        && ((request.resource.data.kind in ['earn', 'penalty']
             && !(request.resource.data.item in ['levelup', 'beltup', 'blackbelt']))
          || (request.resource.data.kind == 'redeem' && request.resource.data.item in quickPerks()))
        && request.resource.data.get('amt', 0) is number && request.resource.data.get('amt', 0) <= 10000);
      allow update: if isDirector();
      allow delete: if isDirector() || (isSensei() && resource.data.by == request.auth.uid
        && (resource.data.kind in ['earn', 'penalty'] || (resource.data.kind == 'redeem' && resource.data.item in quickPerks())));
    }
    match /news/{id} {
      allow read: if canSee();
      allow create: if isSensei() && request.resource.data.by == request.auth.uid;
      allow update: if isDirector();
      allow delete: if isSensei();
    }
    match /requests/{id} {
      allow read: if canView() || (isFamily() && resource.data.by == request.auth.uid);
      allow create: if request.resource.data.by == request.auth.uid && request.resource.data.status == 'pending'
        && (isSensei()
          || (isFamily() && request.resource.data.type == 'redeem' && request.resource.data.ninjaId == famNinja()
              && request.resource.data.item in parentItems()));
      allow update: if isDirector();
      allow delete: if isDirector() || ((isSensei() || isFamily()) && resource.data.by == request.auth.uid && resource.data.status == 'pending');
    }
    // Sensei Bucks: staff only. Only the owner gives, takes and approves; senseis request rewards for themselves.
    match /sensei/{uid} {
      allow read: if canView();
      allow write: if isOwner();
    }
    match /slog/{id} {
      allow read: if canView();
      allow write: if isOwner();
    }
    match /sconfig/{doc} {
      allow read: if canView();
      allow write: if isOwner();
    }
    match /sreq/{id} {
      allow read: if isOwner() || (isSensei() && resource.data.by == request.auth.uid);
      allow create: if isSensei() && request.resource.data.by == request.auth.uid && request.resource.data.senseiId == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.cost is number;
      allow update: if isOwner();
      allow delete: if isOwner() || (isSensei() && resource.data.by == request.auth.uid && resource.data.status == 'pending');
    }
    match /families/{uid} {
      allow read: if isDirector() || (signedIn() && request.auth.uid == uid);
      allow write: if isDirector();
    }
  }
}
